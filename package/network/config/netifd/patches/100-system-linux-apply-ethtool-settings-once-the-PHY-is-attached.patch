From 144818420872edf81bff9bd3633c660d52d809c3 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Fri, 18 Sep 2026 16:00:27 +0100
Subject: [PATCH] system-linux: apply ethtool settings once the PHY is attached

Drivers that attach the PHY in ndo_open(), r8169 among them, return
-ENODEV for every phylib ethtool operation while the interface is
down. netifd configures the link just before bringing the interface
up, so speed, duplex, autoneg, pause and eee are silently dropped on
those devices and the link negotiates whatever the driver defaults to.

Read the link settings before applying anything and, when the device
answers -ENODEV, defer the whole ethtool configuration to
system_if_apply_settings_after_up(), which runs once the interface is
up and the PHY is connected. The read also replaces the one the
function did further down; its first ioctl only negotiates the bitmap
size and is answered by the ethtool core without reaching the driver,
so it cannot be used on its own to tell whether a PHY is attached.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 device.h       |  2 ++
 system-linux.c | 84 +++++++++++++++++++++++++++++++++++---------------
 2 files changed, 62 insertions(+), 24 deletions(-)

--- a/device.h
+++ b/device.h
@@ -337,6 +337,8 @@ struct device {
 
 	struct device_user parent;
 
+	bool ethtool_pending;
+
 	struct device_settings orig_settings;
 	struct device_settings settings;
 };
--- a/system-linux.c
+++ b/system-linux.c
@@ -90,6 +90,11 @@ struct event_socket {
 	int bufsize;
 };
 
+struct ethtool_link_settings_buf {
+	struct ethtool_link_settings req;
+	__u32 link_mode_data[3 * 127];
+};
+
 static int sock_ioctl = -1;
 static struct nl_sock *sock_rtnl = NULL;
 static struct nl_sock *sock_genl = NULL;
@@ -2505,19 +2510,59 @@ static int system_pse_set(struct device
 	return 0;
 }
 
-static void
-system_set_ethtool_settings(struct device *dev, struct device_settings *s)
+static int
+system_ethtool_link_settings_get(struct device *dev,
+				 struct ethtool_link_settings_buf *ecmd)
 {
-	struct {
-		struct ethtool_link_settings req;
-		__u32 link_mode_data[3 * 127];
-	} ecmd;
 	struct ifreq ifr = {
-		.ifr_data = (caddr_t)&ecmd,
+		.ifr_data = (caddr_t)ecmd,
 	};
-	size_t i;
-	__s8 nwords;
+
+	memset(ecmd, 0, sizeof(*ecmd));
+	ecmd->req.cmd = ETHTOOL_GLINKSETTINGS;
+	strncpy(ifr.ifr_name, dev->ifname, sizeof(ifr.ifr_name) - 1);
+
+	/* The first call only negotiates the bitmap size and is answered by
+	 * the ethtool core, the second one reaches the driver.
+	 */
+	if (ioctl(sock_ioctl, SIOCETHTOOL, &ifr) < 0)
+		return -errno;
+
+	if (ecmd->req.link_mode_masks_nwords >= 0 ||
+	    ecmd->req.cmd != ETHTOOL_GLINKSETTINGS)
+		return -EOPNOTSUPP;
+
+	ecmd->req.link_mode_masks_nwords = -ecmd->req.link_mode_masks_nwords;
+
+	if (ioctl(sock_ioctl, SIOCETHTOOL, &ifr) < 0)
+		return -errno;
+
+	if (ecmd->req.link_mode_masks_nwords <= 0 ||
+	    ecmd->req.cmd != ETHTOOL_GLINKSETTINGS)
+		return -EOPNOTSUPP;
+
+	return 0;
+}
+
+static void
+system_set_ethtool_settings(struct device *dev, struct device_settings *s)
+{
+	struct ethtool_link_settings_buf ecmd;
 	__u32 *supported, *advertising;
+	struct ifreq ifr;
+	__s8 nwords;
+	size_t i;
+	int err;
+
+	ifr.ifr_data = (caddr_t)&ecmd;
+
+	/* Drivers that attach the PHY in ndo_open(), r8169 among them, fail
+	 * every phylib ethtool operation while the interface is down.
+	 */
+	err = system_ethtool_link_settings_get(dev, &ecmd);
+	dev->ethtool_pending = err == -ENODEV;
+	if (dev->ethtool_pending)
+		return;
 
 	system_set_ethtool_pause(dev, s);
 
@@ -2528,25 +2573,13 @@ system_set_ethtool_settings(struct devic
 	if (s->flags & (DEV_OPT_PSE | DEV_OPT_PSE_PODL | DEV_OPT_PSE_POWER_LIMIT | DEV_OPT_PSE_PRIORITY))
 		system_pse_set(dev, s);
 
-	/* Avoid a rmw ioctl call if nothing needs to be changed. */
-	if (!(s->flags & (DEV_OPT_AUTONEG | DEV_OPT_SPEED | DEV_OPT_DUPLEX | DEV_OPT_PAUSE | DEV_OPT_ASYM_PAUSE)))
+	if (err)
 		return;
 
-	memset(&ecmd, 0, sizeof(ecmd));
-	ecmd.req.cmd = ETHTOOL_GLINKSETTINGS;
-	strncpy(ifr.ifr_name, dev->ifname, sizeof(ifr.ifr_name) - 1);
-
-	if (ioctl(sock_ioctl, SIOCETHTOOL, &ifr) < 0 ||
-	    ecmd.req.link_mode_masks_nwords >= 0 ||
-	    ecmd.req.cmd != ETHTOOL_GLINKSETTINGS)
+	if (!(s->flags & (DEV_OPT_AUTONEG | DEV_OPT_SPEED | DEV_OPT_DUPLEX | DEV_OPT_PAUSE | DEV_OPT_ASYM_PAUSE)))
 		return;
 
-	ecmd.req.link_mode_masks_nwords = -ecmd.req.link_mode_masks_nwords;
-
-	if (ioctl(sock_ioctl, SIOCETHTOOL, &ifr) < 0 ||
-	    ecmd.req.link_mode_masks_nwords <= 0 ||
-	    ecmd.req.cmd != ETHTOOL_GLINKSETTINGS)
-		return;
+	strncpy(ifr.ifr_name, dev->ifname, sizeof(ifr.ifr_name) - 1);
 
 	nwords = ecmd.req.link_mode_masks_nwords;
 	supported = &ecmd.link_mode_data[0];
@@ -2594,6 +2627,9 @@ system_set_ethtool_settings(struct devic
 static void
 system_set_ethtool_settings_after_up(struct device *dev, struct device_settings *s)
 {
+	if (dev->ethtool_pending)
+		system_set_ethtool_settings(dev, s);
+
 	if (s->flags & DEV_OPT_GRO)
 		system_set_ethtool_gro(dev, s);
 }
