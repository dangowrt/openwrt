/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "urx641.dtsi"

/ {
	compatible = "mxl,mxl25641-hdk-6", "mxl,urx641", "mxl,lgm", "intel,lgm";
	model = "MaxLinear MxL25641-HDK-6";

	aliases {
		led-boot = &led_pwr_white;
		led-failsafe = &led_pwr_red;
		led-running = &led_pwr_white;
		led-upgrade = &led_pwr_white;
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio2 4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	reg_usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
	};
};

&gpio0 {
	led-en-hog {
		gpio-hog;
		gpios = <23 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "led_en";
	};
};

&gpio1 {
	sso-rst-hog {
		gpio-hog;
		gpios = <16 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sso_rst";
	};
};

&pinctrl {
	pinctrl_ledc: ledc-pins {
		pins = <4>, <5>, <6>;
		function = "ledc";
		pinmux = <1>, <1>, <1>;
		groups = "ledc";
	};
};

&ssoled0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ledc>;
	status = "okay";

	led-controller {
		#address-cells = <1>;
		#size-cells = <0>;

		led@8 {
			reg = <8>;
			function = "voip";
			color = <LED_COLOR_ID_BLUE>;
			led-gpios = <&ssoled0 8 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led@9 {
			reg = <9>;
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_BLUE>;
			led-gpios = <&ssoled0 9 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
			default-state = "off";
		};

		led_pwr_white: led@10 {
			reg = <10>;
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_WHITE>;
			led-gpios = <&ssoled0 10 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_pwr_red: led@11 {
			reg = <11>;
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_RED>;
			led-gpios = <&ssoled0 11 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led@13 {
			reg = <13>;
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_BLUE>;
			led-gpios = <&ssoled0 13 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led@14 {
			reg = <14>;
			function = "fwa";
			color = <LED_COLOR_ID_BLUE>;
			led-gpios = <&ssoled0 14 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led@15 {
			reg = <15>;
			function = "pon";
			color = <LED_COLOR_ID_BLUE>;
			led-gpios = <&ssoled0 15 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};
};

&emmc {
	status = "okay";
};

&pcie4 {
	reset-gpios = <&gpio2 19 GPIO_ACTIVE_LOW>;
	num-lanes = <1>;
};

&pcie5 {
	reset-gpios = <&gpio2 20 GPIO_ACTIVE_LOW>;
};

&usb_phy1 {
	vbus-supply = <&reg_usb_vbus>;
	status = "okay";
};

&usb1 {
	status = "okay";
};
